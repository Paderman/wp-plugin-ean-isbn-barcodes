msgstr "Livre avec complément de prix à 5 chiffres (5 = dollars US, 24,99)"

#: includes/class-eanbc-admin.php:812
msgid "ISSN + issue"
msgstr "ISSN + numéro"

#: includes/class-eanbc-admin.php:812
msgid "ISSN – periodical with issue number 05 as add-on"
msgstr "ISSN – périodique avec le numéro 05 en complément"

#: includes/class-eanbc-admin.php:813
msgid "ISMN – sheet music"
msgstr "ISMN – partitions"

#: includes/class-eanbc-admin.php:814
msgid "QR code"
msgstr "Code QR"

#: includes/class-eanbc-admin.php:814
