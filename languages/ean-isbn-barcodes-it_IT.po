msgstr ""
"Valori predefiniti ripristinati. Si applicano dopo aver fatto clic su “Salva"
" impostazioni”."

#: includes/class-eanbc-admin.php:206
msgid "All builder fields reset."
msgstr "Tutti i campi del generatore sono stati reimpostati."

#: includes/class-eanbc-admin.php:207
