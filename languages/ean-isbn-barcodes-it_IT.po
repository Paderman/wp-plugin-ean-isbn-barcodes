#. Plugin Name of the plugin
#: ean-isbn-barcodes.php includes/class-eanbc-admin.php:61
#: includes/class-eanbc-admin.php:494 includes/class-eanbc-admin.php:502
#: includes/class-eanbc-providers.php:205
msgid "EAN & ISBN Barcodes"
msgstr "Codici a barre EAN e ISBN"

#. Plugin URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"
msgstr "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"

#. Description of the plugin
#: ean-isbn-barcodes.php
msgid ""
"EAN, UPC, ISBN, ISSN and ISMN barcodes as block or shortcode – with product "
"names and product cards from several data sources (Open Library, Open Food "
"Facts, ean-search.org)."
msgstr ""
"Codici a barre EAN, UPC, ISBN, ISSN e ISMN come blocco o shortcode – con "
"nomi e schede prodotto da più fonti di dati (Open Library, Open Food Facts, "
"ean-search.org)."

#. Author of the plugin
#: ean-isbn-barcodes.php
msgid "pader-man"
msgstr "pader-man"

#. Author URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman"
msgstr "https://github.com/Paderman"

#: includes/class-eanbc-admin.php:138
msgid "Settings"
msgstr "Impostazioni"

#: includes/class-eanbc-admin.php:139 includes/class-eanbc-admin.php:1081
msgid "Shortcodes"
msgstr "Shortcode"

#: includes/class-eanbc-admin.php:162
msgid "EAN & ISBN Barcodes is ready."
msgstr "Codici a barre EAN e ISBN è pronto."

#: includes/class-eanbc-admin.php:163
msgid ""
"You will find all settings in the left admin menu under “EAN & ISBN "
"Barcodes” (directly below “Settings”). You can move the entry later if you "
"prefer."
msgstr ""
"Tutte le impostazioni si trovano nel menu di amministrazione a sinistra, "
"sotto “Codici a barre EAN e ISBN” (subito sotto “Impostazioni”). La voce può"
" essere spostata in seguito, se si preferisce."

#: includes/class-eanbc-admin.php:165
msgid "Open settings"
msgstr "Apri impostazioni"

