msgid "EAN & ISBN Barcodes"
msgstr "EAN- & ISBN-barcodes"

#. Plugin URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"
msgstr "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"

#. Description of the plugin
#: ean-isbn-barcodes.php
msgid ""
"EAN, UPC, ISBN, ISSN and ISMN barcodes as block or shortcode – with product "
"names and product cards from several data sources (Open Library, Open Food "
"Facts, ean-search.org)."
msgstr ""
"EAN-, UPC-, ISBN-, ISSN- en ISMN-barcodes als blok of shortcode – met "
"productnamen en productkaarten uit meerdere gegevensbronnen (Open Library, "
"Open Food Facts, ean-search.org)."

#. Author of the plugin
#: ean-isbn-barcodes.php
msgid "pader-man"
msgstr "pader-man"

#. Author URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman"
msgstr "https://github.com/Paderman"

