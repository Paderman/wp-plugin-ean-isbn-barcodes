#. Plugin Name of the plugin
#: ean-isbn-barcodes.php includes/class-eanbc-admin.php:61
#: includes/class-eanbc-admin.php:494 includes/class-eanbc-admin.php:502
#: includes/class-eanbc-providers.php:205
msgid "EAN & ISBN Barcodes"
msgstr "EAN- & ISBN-Barcodes"

#. Plugin URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"
msgstr "https://github.com/Paderman/wp-plugin-ean-isbn-barcodes"

#. Description of the plugin
#: ean-isbn-barcodes.php
msgid ""
"EAN, UPC, ISBN, ISSN and ISMN barcodes as block or shortcode – with product "
"names and product cards from several data sources (Open Library, Open Food "
"Facts, ean-search.org)."
msgstr ""
"EAN-, UPC-, ISBN-, ISSN- und ISMN-Barcodes als Block oder Shortcode – mit "
"Produktnamen und Produktkarten aus mehreren Datenquellen (Open Library, Open"
" Food Facts, ean-search.org)."

#. Author of the plugin
#: ean-isbn-barcodes.php
msgid "pader-man"
msgstr "pader-man"

#. Author URI of the plugin
#: ean-isbn-barcodes.php
msgid "https://github.com/Paderman"
msgstr "https://github.com/Paderman"

#: includes/class-eanbc-admin.php:138
