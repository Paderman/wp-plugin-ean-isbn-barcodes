#: includes/class-eanbc-barcode.php:216
#, php-format
msgid ""
"Unsupported length (%d digits). Use 8 (EAN-8, UPC-E), 12 (UPC-A) or 13 "
"(EAN-13) digits, an ISBN-10 or an ISSN."
msgstr ""
"Nicht unterstützte Länge (%d Ziffern). Möglich sind 8 (EAN-8, UPC-E), 12 "
"(UPC-A) oder 13 (EAN-13) Ziffern, eine ISBN-10 oder eine ISSN."

