msgstr "ISSN – Zeitschrift mit Heftnummer 05 als Add-on"

#: includes/class-eanbc-admin.php:813
msgid "ISMN – sheet music"
msgstr "ISMN – Musiknoten"

#: includes/class-eanbc-admin.php:814
msgid "QR code"
msgstr "QR-Code"

#: includes/class-eanbc-admin.php:814
